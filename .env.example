# ElevenLabs — server-side only, never NEXT_PUBLIC_
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Neon Postgres (use the pooled connection string, sslmode=require)
DATABASE_URL=

# Anthropic — post-call scorecard
ANTHROPIC_API_KEY=

# Optional: zone for displayed dates and the analytics "this week" rule
# APP_TIMEZONE=America/New_York

# Clerk — `clerk env pull` fills the first two
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
